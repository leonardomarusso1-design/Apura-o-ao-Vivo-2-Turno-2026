# Site
NEXT_PUBLIC_SITE_URL=https://SEUDOMINIO.com.br
NEXT_PUBLIC_SITE_NAME=Apuração ao Vivo
# Data/hora do fim da votação (horário de Brasília) — 2º turno
NEXT_PUBLIC_ELECTION_ISO=2026-10-25T17:00:00-03:00

# Supabase (SERVICE ROLE só no servidor, nunca NEXT_PUBLIC)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt p/ hash de IP (string aleatória longa)
IP_HASH_SALT=troque-isto

# Upstash Redis (opcional: contador "online agora" e rate limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comercial / apoio
NEXT_PUBLIC_WHATSAPP_COMERCIAL=5519999999999
NEXT_PUBLIC_EMAIL_COMERCIAL=contato@SEUDOMINIO.com.br
# Pix copia-e-cola do site (chave/BR Code). Apoio ao SITE, não a candidato.
NEXT_PUBLIC_PIX_COPIA_COLA=

# --- Apuração (TSE) ---
# 6258 = Presidente 2º turno 2026 | 6257 = Presidente 1º turno
TSE_ELEICAO=6258
# Enquanto o 2º turno não tem dados, mostra o 1º turno como PRÉVIA (com aviso na tela). Remova depois do dia 25.
TSE_PREVIA_ELEICAO=6257
# Só para demonstração local com números fictícios (nunca em produção real)
# APURACAO_MOCK=1

# --- Anti-robô (opcional, recomendado): Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=
